<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The UI shell is being rebuilt in WPF (WPF-UI Fluent design); WinForms stays for the engine-owned
         chromeless overlays (BorderWnd, LayoutOverlayForm, MonitorPickerForm) and the Keys enum used in
         persisted settings. Single project keeps the TTMulti.Properties.Settings config section name intact. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Keep implicit usings / nullable OFF so the retarget stays a pure runtime swap with zero source churn. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>TTMulti</RootNamespace>
    <AssemblyName>ToontownMulticontroller</AssemblyName>
    <!-- AnyCPU (runs 64-bit on a 64-bit OS). The forced x86 was unjustified; all interop is IntPtr-based and
         PostMessage/LL-hooks work cross-bitness. Revert to x86 here if a real-game issue ever appears (BUILD-07). -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Keep the hand-written Properties/AssemblyInfo.cs instead of SDK auto-generated attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <!-- With the WPF (WinFx) and ClickOnce manifest pipelines gone, this now embeds as the native Win32 manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <!-- Roslyn analyzers on (opt-in for .NET Framework), Default level, warnings only — never fail the build. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Keep the flat bin\Debug\ output layout (not bin\Debug\net481\) that the old project and tooling expect. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- WinForms .resx are named from their adjacent .cs class (matches the old DependentUpon behavior). -->
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <!-- The resx files embed binary resources (cursors/bitmaps via ResXFileRef). The modern build (dotnet/newer
         msbuild) requires the preserialized-resource path + System.Resources.Extensions to read them. -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <!-- NU1510 hints that these two packages are "likely unnecessary" because the modern framework nominally
         provides them. Both are genuinely required: System.Configuration.ConfigurationManager supplies the
         SettingsProvider/ApplicationSettingsBase types PortableSettingsProvider extends, and
         System.Resources.Extensions is needed to read the binary (preserialized) resx resources at runtime.
         WFO0003 wants high-DPI config out of app.manifest and into code; we deliberately keep it in the manifest
         (applies before the first window is created — Application.SetHighDpiMode is only the unembedded-manifest
         fallback). Revisit WFO0003 alongside PerMonitorV2 in the UI stage. -->
    <NoWarn>$(NoWarn);NU1510;WFO0003</NoWarn>
  </PropertyGroup>

  <!-- The test project lives under tests/ inside this project's directory; keep its sources out of the app's
       default **/*.cs glob (they reference xUnit, which the app does not). -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <!-- Framework references (System.*, System.Drawing, System.Runtime.Serialization, Microsoft.CSharp) come
       implicitly from the WindowsDesktop shared framework once UseWindowsForms is set. Only out-of-framework
       packages are listed. System.Configuration.ConfigurationManager provides the ApplicationSettingsBase /
       SettingsProvider stack the portable PortableSettingsProvider extends. System.Resources.Extensions is
       required at runtime to read the binary (preserialized) resx resources. -->
  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
    <!-- Fluent 2 / Windows 11 design system for the WPF shell. Version pinned exactly; upgrade only as its
         own commit (API churn risk). -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- Settings + Resources: keep the designer generators and dependency metadata (files themselves are globbed). -->
  <ItemGroup>
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
