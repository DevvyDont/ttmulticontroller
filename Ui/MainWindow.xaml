<ui:FluentWindow
    x:Class="TTMulti.Ui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:TTMulti.Ui.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Multicontroller"
    Width="264"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Mode selector rendered as a filled(on) / outlined(off) coloured button. BorderBrush carries the
             mode's colour; RadioButtons stay mutually exclusive and can't be clicked off. -->
        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="fill" CornerRadius="6" Background="{TemplateBinding BorderBrush}" Opacity="0" />
                            <Border CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" />
                            <TextBlock x:Name="label"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{TemplateBinding BorderBrush}"
                                Text="{TemplateBinding Content}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fill" Property="Opacity" Value="1" />
                                <Setter TargetName="label" Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="fill" Property="Opacity" Value="0.15" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <!-- Mode-colour wash sits behind the title bar and fades to transparent toward the bottom (vertical
                 OpacityMask) so it melts into the window background instead of butting up against the content
                 below. It's a separate element from the TitleBar, so the fade never dims the title text or the
                 caption buttons. -->
            <Border Background="{Binding TitleBarBrush}">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#FFFFFFFF" />
                        <GradientStop Offset="0.5" Color="#FFFFFFFF" />
                        <GradientStop Offset="1.0" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <ui:TitleBar
                x:Name="titleBar"
                Height="30"
                VerticalAlignment="Top"
                Title="Multicontroller"
                ShowMaximize="False"
                ShowMinimize="False" />
        </Grid>

        <StackPanel Grid.Row="1" x:Name="contentRoot" Margin="16,6,16,10">

            <!-- Toon window pairing with the centre column between the two toon pickers. The centre holds the
                 Multi/Mirror mode selector (default) OR the Options/Groups action buttons (compact). The row's
                 alignment + centre-column width are set per mode in ApplyModeHeight (spread wide when normal;
                 tight, centred cluster when compact). -->
            <Grid x:Name="crosshairRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="centerColumn" Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ctrl:WindowCrosshair
                    x:Name="leftCrosshair"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    TileSize="{Binding CrosshairTileSize}"
                    AccentBrush="{Binding LeftAccentBrush}"
                    SelectedWindowHandle="{Binding LeftWindowHandle, Mode=OneWay}" />

                <!-- Centre column: two variants overlaid, toggled by the compactUI setting. Both stack two
                     controls that fill the toon-tile height, splitting it evenly. -->
                <Grid Grid.Column="1" Margin="8,0" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Default: Multi / Mirror mode selector -->
                    <RadioButton
                        Grid.Row="0"
                        Style="{StaticResource ModeButton}"
                        Margin="0,0,0,2"
                        Content="Multi"
                        GroupName="Mode"
                        BorderBrush="{Binding MultiModeBrush}"
                        IsChecked="{Binding IsMultiMode, Mode=TwoWay}"
                        IsEnabled="{Binding AreModeButtonsEnabled}"
                        Visibility="{Binding IsNotCompact, Converter={StaticResource BoolToVis}}" />
                    <RadioButton
                        Grid.Row="1"
                        Style="{StaticResource ModeButton}"
                        Margin="0,2,0,0"
                        Content="Mirror"
                        GroupName="Mode"
                        BorderBrush="{Binding MirrorModeBrush}"
                        IsChecked="{Binding IsMirrorMode, Mode=TwoWay}"
                        IsEnabled="{Binding AreModeButtonsEnabled}"
                        Visibility="{Binding IsNotCompact, Converter={StaticResource BoolToVis}}" />

                    <!-- Compact: Options / Groups action buttons (mode is switched by hotkey in this layout) -->
                    <ui:Button
                        Grid.Row="0"
                        MinHeight="0"
                        Width="54"
                        Padding="4,1"
                        Margin="0,0,0,2"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Appearance="Primary"
                        ToolTip="Options"
                        Click="OptionsButton_Click"
                        Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Settings24" FontSize="15" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Grid.Row="1"
                        MinHeight="0"
                        Width="54"
                        Padding="4,1"
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        ToolTip="Window Groups"
                        Click="GroupsButton_Click"
                        Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Grid24" FontSize="15" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>

                <ctrl:WindowCrosshair
                    x:Name="rightCrosshair"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    TileSize="{Binding CrosshairTileSize}"
                    AccentBrush="{Binding RightAccentBrush}"
                    SelectedWindowHandle="{Binding RightWindowHandle, Mode=OneWay}" />
            </Grid>

            <!-- State chips -->
            <StackPanel
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Border
                    Padding="8,3"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    CornerRadius="10"
                    Visibility="{Binding IsSuspended, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="Hotkeys suspended" />
                </Border>
                <Border
                    Padding="8,3"
                    Margin="6,0,0,0"
                    Background="{DynamicResource SystemFillColorNeutralBackgroundBrush}"
                    CornerRadius="10"
                    Visibility="{Binding IsModeLocked, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Mode locked" />
                </Border>
            </StackPanel>

            <!-- Status (default): mode name on the left, icon-only Groups / Options on the right. -->
            <Grid
                Margin="0,10,0,0"
                Visibility="{Binding IsNotCompact, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding ModeSummary}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button
                        x:Name="groupsButton"
                        Margin="0,0,6,0"
                        Icon="{ui:SymbolIcon Grid24}"
                        ToolTip="Window Groups"
                        Click="GroupsButton_Click" />
                    <ui:Button
                        x:Name="optionsButton"
                        Appearance="Primary"
                        Icon="{ui:SymbolIcon Settings24}"
                        ToolTip="Options"
                        Click="OptionsButton_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
