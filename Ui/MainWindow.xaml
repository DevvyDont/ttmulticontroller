<ui:FluentWindow
    x:Class="TTMulti.Ui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:TTMulti.Ui.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Toontown Multicontroller"
    Width="340"
    MinWidth="320"
    ResizeMode="CanMinimize"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="Toontown Multicontroller"
            ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="16,4,16,16">

            <!-- Toon window pairing -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <ctrl:WindowCrosshair
                        x:Name="leftCrosshair"
                        HorizontalAlignment="Center"
                        AccentBrush="{Binding LeftAccentBrush}"
                        SelectedWindowHandle="{Binding LeftWindowHandle, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Text="Left toon" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <ctrl:WindowCrosshair
                        x:Name="rightCrosshair"
                        HorizontalAlignment="Center"
                        AccentBrush="{Binding RightAccentBrush}"
                        SelectedWindowHandle="{Binding RightWindowHandle, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Text="Right toon" />
                </StackPanel>
            </Grid>

            <!-- Mode selector -->
            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <RadioButton
                    x:Name="multiRadio"
                    MinWidth="80"
                    Content="Multi"
                    GroupName="Mode"
                    IsChecked="{Binding IsMultiMode, Mode=TwoWay}"
                    IsEnabled="{Binding AreModeButtonsEnabled}" />
                <RadioButton
                    x:Name="mirrorRadio"
                    MinWidth="80"
                    Margin="16,0,0,0"
                    Content="Mirror"
                    GroupName="Mode"
                    IsChecked="{Binding IsMirrorMode, Mode=TwoWay}"
                    IsEnabled="{Binding AreModeButtonsEnabled}" />
            </StackPanel>

            <!-- Live status -->
            <TextBlock
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Text="{Binding ModeSummary}" />
            <TextBlock
                Margin="0,2,0,0"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding GroupCountText}" />

            <!-- State chips -->
            <StackPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Border
                    Padding="8,3"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    CornerRadius="10"
                    Visibility="{Binding IsSuspended, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="Hotkeys suspended" />
                </Border>
                <Border
                    Padding="8,3"
                    Margin="6,0,0,0"
                    Background="{DynamicResource SystemFillColorNeutralBackgroundBrush}"
                    CornerRadius="10"
                    Visibility="{Binding IsModeLocked, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Mode locked" />
                </Border>
            </StackPanel>

            <!-- Actions -->
            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <ui:Button
                    x:Name="groupsButton"
                    Margin="0,0,8,0"
                    Content="Window Groups"
                    Icon="{ui:SymbolIcon Grid24}"
                    Click="GroupsButton_Click" />
                <ui:Button
                    x:Name="optionsButton"
                    Appearance="Primary"
                    Content="Options"
                    Icon="{ui:SymbolIcon Settings24}"
                    Click="OptionsButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
