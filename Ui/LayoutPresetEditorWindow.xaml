<ui:FluentWindow
    x:Class="TTMulti.Ui.LayoutPresetEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:TTMulti.Ui.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Edit Layout Preset"
    Width="720"
    Height="620"
    MinWidth="620"
    MinHeight="560"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Edit Layout Preset" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" Padding="16,4,16,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Name + hotkey -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Name" />
                            <TextBox x:Name="nameBox" Grid.Column="1" Margin="12,0,0,0" />
                        </Grid>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Hotkey" />
                            <ctrl:KeyPickerBox x:Name="hotkeyBox" Margin="12,0,0,0" />
                            <CheckBox x:Name="hotkeyAlt" Margin="16,0,0,0" VerticalAlignment="Center" Content="Alt" />
                            <CheckBox x:Name="hotkeyCtrl" Margin="8,0,0,0" VerticalAlignment="Center" Content="Ctrl" />
                            <CheckBox x:Name="hotkeyShift" Margin="8,0,0,0" VerticalAlignment="Center" Content="Shift" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Regions -->
                <TextBlock Margin="2,14,0,4" FontWeight="SemiBold" Text="Regions" />
                <TextBlock
                    Margin="2,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Each region defines a grid area; toon windows fill the grid cells (slots) from the regions in order." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <ListBox
                            x:Name="regionList"
                            Height="150"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding Regions}"
                            SelectedItem="{Binding SelectedRegion, Mode=TwoWay}" />
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <ui:Button Content="Add" Click="AddRegion_Click" />
                            <ui:Button Margin="6,0,0,0" Content="Remove" Click="RemoveRegion_Click" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource Card}" DataContext="{Binding SelectedRegion}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Source" />
                                <ComboBox Grid.Column="1" Margin="12,0,0,0" SelectedIndex="{Binding SourceIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Monitor" />
                                    <ComboBoxItem Content="Custom rectangle" />
                                </ComboBox>
                                <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="Pick monitor…" Click="PickMonitor_Click" />
                            </Grid>
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Visibility="{Binding IsMonitor, Converter={StaticResource BoolToVis}}">
                                <TextBlock VerticalAlignment="Center" Text="Monitor #" />
                                <TextBox Width="60" Margin="12,0,0,0" Text="{Binding MonitorIndex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <Grid Margin="0,8,0,0" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="X" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="8,2" Text="{Binding CustomX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="Y" />
                                <TextBox Grid.Row="0" Grid.Column="3" Margin="8,2" Text="{Binding CustomY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="W" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="8,2" Text="{Binding CustomWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="H" />
                                <TextBox Grid.Row="1" Grid.Column="3" Margin="8,2" Text="{Binding CustomHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Rows" />
                                <TextBox Grid.Column="1" Margin="8,0" Text="{Binding Rows, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Cols" />
                                <TextBox Grid.Column="3" Margin="8,0" Text="{Binding Cols, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Row / Col weights" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal">
                                    <TextBox Width="90" Text="{Binding RowWeightsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="Optional, comma-separated" />
                                    <TextBox Width="90" Margin="8,0,0,0" Text="{Binding ColWeightsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="Optional, comma-separated" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <ui:Button Content="Set area on screen…" Click="SetAreaOnScreen_Click" />
                    <ui:Button Margin="8,0,0,0" Content="Edit all on screen…" Click="EditAllOnScreen_Click" />
                    <ui:Button Margin="8,0,0,0" Content="Edit slots on screen…" Click="EditSlotsOnScreen_Click" />
                </StackPanel>

                <!-- Slot overrides -->
                <TextBlock Margin="2,14,0,4" FontWeight="SemiBold" Text="Slot overrides (optional)" />
                <DataGrid
                    x:Name="slotGrid"
                    Height="170"
                    AutoGenerateColumns="False"
                    CanUserAddRows="True"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding SlotRows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Slot}" Header="Slot" Width="50" />
                        <DataGridCheckBoxColumn Binding="{Binding OverrideRect, UpdateSourceTrigger=PropertyChanged}" Header="Override position" Width="110" />
                        <DataGridTextColumn Binding="{Binding X}" Header="X" Width="*" />
                        <DataGridTextColumn Binding="{Binding Y}" Header="Y" Width="*" />
                        <DataGridTextColumn Binding="{Binding Width}" Header="Width" Width="*" />
                        <DataGridTextColumn Binding="{Binding Height}" Header="Height" Width="*" />
                        <DataGridCheckBoxColumn Binding="{Binding Minimized, UpdateSourceTrigger=PropertyChanged}" Header="Minimized" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="16,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button MinWidth="90" Appearance="Primary" Content="OK" Click="Ok_Click" />
                <ui:Button MinWidth="90" Margin="8,0,0,0" Content="Cancel" Click="Cancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
