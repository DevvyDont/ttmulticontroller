<Window
    x:Class="TTMulti.Ui.LayoutPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:TTMulti.Ui.Controls"
    Title="Layout preview"
    Width="480"
    Height="340"
    MinWidth="240"
    MinHeight="180"
    Topmost="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource ApplicationBackgroundBrush}">
    <ctrl:LayoutPreview
        Margin="8"
        Preset="{Binding SelectedPreset.Preset}"
        SelectedRegionIndex="{Binding SelectedPreset.SelectedRegionIndex}"
        Rev="{Binding SelectedPreset.PreviewRev}" />
</Window>
