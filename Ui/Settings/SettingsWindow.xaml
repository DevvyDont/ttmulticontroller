<ui:FluentWindow
    x:Class="TTMulti.Ui.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:TTMulti.Ui.Controls"
    xmlns:local="clr-namespace:TTMulti.Ui.Settings"
    xmlns:props="clr-namespace:TTMulti.Properties"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Options"
    Width="760"
    Height="600"
    MinWidth="640"
    MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.Resources>
        <local:InverseBooleanConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,14,0,6" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="Options"
            ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <ListBox
                x:Name="navList"
                Grid.Column="0"
                Margin="0,0,10,0"
                BorderThickness="0"
                Background="Transparent"
                SelectionChanged="NavList_SelectionChanged">
                <ListBoxItem Content="Multi-Mode Keys" IsSelected="True" />
                <ListBoxItem Content="Controller Modes" />
                <ListBoxItem Content="Custom Modes" />
                <ListBoxItem Content="Hotkeys" />
                <ListBoxItem Content="Multi-Click" />
                <ListBoxItem Content="Auto-Find" />
                <ListBoxItem Content="Layout Presets" />
                <ListBoxItem Content="Colors" />
                <ListBoxItem Content="General" />
            </ListBox>

            <!-- Page content -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <Grid>
                    <!-- ── Multi-Mode Keys ───────────────────────────────────────── -->
                    <StackPanel x:Name="pageKeyBindings" Grid.IsSharedSizeScope="True">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Multi-Mode key bindings" />
                        <TextBlock
                            Margin="2,0,0,8"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            Text="The physical key each toon presses (left / right) to perform each in-game action." />
                        <Grid Margin="14,0,50,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="KCol" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LCol" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="RCol" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Margin="4,0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="In-game key" />
                            <TextBlock Grid.Column="2" Margin="4,0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Left toon" />
                            <TextBlock Grid.Column="3" Margin="4,0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Right toon" />
                        </Grid>
                        <ItemsControl x:Name="keyBindingsItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,4" Padding="10,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="KCol" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LCol" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="RCol" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                Grid.Column="0"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                IsReadOnly="{Binding IsReadOnly}"
                                                Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <ctrl:KeyPickerBox Grid.Column="1" Margin="2,0" KeyCode="{Binding KeyCode, Mode=TwoWay}" />
                                            <ctrl:KeyPickerBox Grid.Column="2" Margin="2,0" KeyCode="{Binding LeftKeyCode, Mode=TwoWay}" />
                                            <ctrl:KeyPickerBox Grid.Column="3" Margin="2,0" KeyCode="{Binding RightKeyCode, Mode=TwoWay}" />
                                            <ui:Button
                                                Grid.Column="4"
                                                Margin="4,0,0,0"
                                                Padding="6"
                                                Click="RemoveBinding_Click"
                                                Icon="{ui:SymbolIcon Delete24}"
                                                Tag="{Binding}"
                                                ToolTip="Remove this binding"
                                                Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button
                            Margin="0,8,0,0"
                            Click="AddBinding_Click"
                            Content="Add binding"
                            Icon="{ui:SymbolIcon Add24}" />
                    </StackPanel>

                    <!-- ── Controller Modes ──────────────────────────────────────── -->
                    <StackPanel x:Name="pageModes" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Group (Multi) Mode" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Switch-to-mode key" />
                                    <ctrl:KeyPickerBox Grid.Column="1" KeyCode="{Binding groupModeKeyCode, Mode=TwoWay}" />
                                </Grid>
                                <CheckBox Margin="0,3" Content="Include in mode-key cycle" IsChecked="{Binding groupModeCycleWithModeHotkey, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Mirror Mode" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Switch-to-mode key" />
                                    <ctrl:KeyPickerBox Grid.Column="1" KeyCode="{Binding mirrorModeKeyCode, Mode=TwoWay}" />
                                </Grid>
                                <CheckBox Margin="0,3" Content="Include in mode-key cycle" IsChecked="{Binding mirrorModeCycleWithModeHotkey, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="All-Groups Mode" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Switch-to-mode key" />
                                    <ctrl:KeyPickerBox Grid.Column="1" KeyCode="{Binding controlAllGroupsKeyCode, Mode=TwoWay}" />
                                </Grid>
                                <CheckBox Margin="0,3" Content="Include in mode-key cycle" IsChecked="{Binding allGroupModeCycleWithModeHotkey, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Switching Mode" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Margin="0,3" Content="Enable Switching Mode" IsChecked="{Binding switchingModeEnabled, Mode=TwoWay}" />
                                <Grid x:Name="switchKeyPanel" Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Switch binding" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox MinWidth="150" SelectedIndex="{Binding ComboIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="Left Mouse Button" />
                                            <ComboBoxItem Content="Right Mouse Button" />
                                            <ComboBoxItem Content="Middle Mouse Button" />
                                            <ComboBoxItem Content="Keyboard Key…" />
                                        </ComboBox>
                                        <ctrl:KeyPickerBox
                                            Margin="8,0,0,0"
                                            MinWidth="120"
                                            KeyCode="{Binding KeyboardKeyCode, Mode=TwoWay}"
                                            Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Remove-from-switch key" />
                                    <ctrl:KeyPickerBox Grid.Column="1" KeyCode="{Binding switchingModeRemoveKeyCode, Mode=TwoWay}" />
                                </Grid>
                                <CheckBox Margin="0,3" Content="Place windows when Alt is released" IsChecked="{Binding autoFindPlacementOnAltRelease, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Hotkeys ────────────────────────────────────────────────── -->
                    <StackPanel x:Name="pageHotkeys" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Mode / Activate" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Mode / activate key" />
                                    <ctrl:KeyPickerBox Grid.Column="1" KeyCode="{Binding modeKeyCode, Mode=TwoWay}" />
                                </Grid>
                                <CheckBox Margin="0,3" Content="Global hotkey (works when other windows are focused)" IsChecked="{Binding modeHotkeyGlobal, Mode=TwoWay}" />
                                <CheckBox Margin="0,3" Content="Start in Mirror mode on launch" IsChecked="{Binding defaultModeOnLaunch, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Instant Multi-Click" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="multiUseMouseChk" Margin="0,3" Content="Trigger with a mouse button" IsChecked="{Binding replicateMouseUseMouseButton, Mode=TwoWay}" />
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Trigger key" />
                                    <ctrl:KeyPickerBox Grid.Column="1"
                                        IsEnabled="{Binding replicateMouseUseMouseButton, Converter={StaticResource InverseBool}}"
                                        KeyCode="{Binding replicateMouseKeyCode, Mode=TwoWay}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Mouse button" />
                                    <ComboBox Grid.Column="1" MinWidth="180"
                                        IsEnabled="{Binding replicateMouseUseMouseButton}"
                                        SelectedIndex="{Binding replicateMouseMouseButton, Mode=TwoWay}">
                                        <ComboBoxItem Content="Middle (wheel click)" />
                                        <ComboBoxItem Content="Mouse 4" />
                                        <ComboBoxItem Content="Mouse 5" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Click order" />
                                    <ComboBox Grid.Column="1" MinWidth="240" SelectedIndex="{Binding multiclickOrder, Mode=TwoWay}">
                                        <ComboBoxItem Content="Controller order (group, pair, L/R)" />
                                        <ComboBoxItem Content="Window order (by position)" />
                                    </ComboBox>
                                </Grid>
                                <CheckBox Margin="0,3" Content="Global hotkey" IsChecked="{Binding replicateMouseHotkeyGlobal, Mode=TwoWay}" />
                                <CheckBox Margin="0,3" Content="Separate left / right clicks" IsChecked="{Binding replicateMouseSeparateLR, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Zero Power Throw" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Zero power throw key" />
                                    <ctrl:KeyPickerBox Grid.Column="1" KeyCode="{Binding zeroPowerThrowKeyCode, Mode=TwoWay}" />
                                </Grid>
                                <CheckBox Margin="0,3" Content="Global hotkey" IsChecked="{Binding zeroPowerThrowHotkeyGlobal, Mode=TwoWay}" />
                                <CheckBox Margin="0,3" Content="Enable focus mode" IsChecked="{Binding zeroPowerThrowEnableFocusMode, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── General ────────────────────────────────────────────────── -->
                    <StackPanel x:Name="pageGeneral" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Window" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Margin="0,3" Content="Keep window on top when inactive" IsChecked="{Binding onTopWhenInactive, Mode=TwoWay}" />
                                <CheckBox Margin="0,3" Content="Compact UI" IsChecked="{Binding compactUI, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Input" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Margin="0,3" Content="Release held keys when switching groups or focusing a game window"
                                          ToolTip="On: movement keys held across a group/pair/mode switch (or when you click a game window to focus it) are released, so toons on the windows you left stop moving. Off (default): those keys stay held — the toons keep moving until you switch back and release the key."
                                          IsChecked="{Binding releaseKeysOnWindowFocus, Mode=TwoWay}" />
                                <CheckBox x:Name="keepAliveChk" Margin="0,3" Content="Enable Keep-Alive" IsChecked="{Binding disableKeepAlive, Converter={StaticResource InverseBool}, Mode=TwoWay}" />
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Keep-Alive key" />
                                    <ctrl:KeyPickerBox Grid.Column="1" KeyCode="{Binding keepAliveKeyCode, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="About" />
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Version, homepage, and update check" />
                                <ui:Button Grid.Column="1" Content="About" Icon="{ui:SymbolIcon Info24}" Click="About_Click" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Appearance" />
                        <Border Style="{StaticResource Card}">
                            <CheckBox Content="Tint the title bar with the current mode colour" IsChecked="{Binding enableCaptionColor, Mode=TwoWay}" />
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Window management" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Minimize unconnected windows key" />
                                    <ctrl:KeyPickerBox Grid.Column="1" KeyCode="{Binding minimizeUnconnectedKeyCode, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel x:Name="minimizeModifiersPanel" Margin="0,3" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource RowLabel}" Margin="0,0,12,0" Text="Modifiers:" />
                                    <CheckBox Margin="0,0,12,0" Content="Alt" IsChecked="{Binding Alt, Mode=TwoWay}" />
                                    <CheckBox Margin="0,0,12,0" Content="Ctrl" IsChecked="{Binding Control, Mode=TwoWay}" />
                                    <CheckBox Content="Shift" IsChecked="{Binding Shift, Mode=TwoWay}" />
                                </StackPanel>
                                <CheckBox Margin="0,3" Content="Minimize-unconnected is a global hotkey" IsChecked="{Binding minimizeUnconnectedHotkeyGlobal, Mode=TwoWay}" />
                                <Grid Margin="0,10,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Mode-lock toggle key" />
                                    <ctrl:KeyPickerBox Grid.Column="1" KeyCode="{Binding modeLockToggleKeyCode, Mode=TwoWay}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Suspend global hotkeys toggle key" />
                                    <ctrl:KeyPickerBox Grid.Column="1" KeyCode="{Binding suspendGlobalHotkeysToggleKeyCode, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Multi-Click (Controlled Multi-Click Mode) ──────────────── -->
                    <StackPanel x:Name="pageMultiClick" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <CheckBox Content="Enable Controlled Multi-Click Mode" IsChecked="{Binding controlledMulticlickEnabled, Mode=TwoWay}" />
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Activation" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Activation key" />
                                    <ctrl:KeyPickerBox Grid.Column="1" KeyCode="{Binding controlledMulticlickActivateKeyCode, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel Margin="0,3" Orientation="Horizontal">
                                    <RadioButton Content="Hold" GroupName="CmActivate" IsChecked="{Binding controlledMulticlickActivateHold, Mode=TwoWay}" />
                                    <RadioButton Margin="16,0,0,0" Content="Toggle" GroupName="CmActivate" IsChecked="{Binding controlledMulticlickActivateHold, Converter={StaticResource InverseBool}, Mode=OneWay}" />
                                </StackPanel>
                                <CheckBox Margin="0,3" Content="Global hotkey" IsChecked="{Binding controlledMulticlickActivateGlobal, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Regular Click" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Margin="0,3" Content="Use a mouse button" IsChecked="{Binding controlledMulticlickRegularClickUseMouseButton, Mode=TwoWay}" />
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Mouse button" />
                                    <ComboBox Grid.Column="1" MinWidth="180"
                                        IsEnabled="{Binding controlledMulticlickRegularClickUseMouseButton}"
                                        SelectedIndex="{Binding controlledMulticlickRegularClickMouseButton, Mode=TwoWay}">
                                        <ComboBoxItem Content="Left click" />
                                        <ComboBoxItem Content="Right click" />
                                        <ComboBoxItem Content="Middle (wheel click)" />
                                        <ComboBoxItem Content="Mouse 4" />
                                        <ComboBoxItem Content="Mouse 5" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Key" />
                                    <ctrl:KeyPickerBox Grid.Column="1"
                                        IsEnabled="{Binding controlledMulticlickRegularClickUseMouseButton, Converter={StaticResource InverseBool}}"
                                        KeyCode="{Binding controlledMulticlickRegularClickKeyCode, Mode=TwoWay}" />
                                </Grid>
                                <CheckBox Margin="0,3" Content="Trigger on release" IsChecked="{Binding controlledMulticlickRegularClickTriggerOnRelease, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Multi-Click" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Margin="0,3" Content="Use a mouse button" IsChecked="{Binding controlledMulticlickClickUseMouseButton, Mode=TwoWay}" />
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Mouse button" />
                                    <ComboBox Grid.Column="1" MinWidth="180"
                                        IsEnabled="{Binding controlledMulticlickClickUseMouseButton}"
                                        SelectedIndex="{Binding controlledMulticlickClickMouseButton, Mode=TwoWay}">
                                        <ComboBoxItem Content="Left click" />
                                        <ComboBoxItem Content="Right click" />
                                        <ComboBoxItem Content="Middle (wheel click)" />
                                        <ComboBoxItem Content="Mouse 4" />
                                        <ComboBoxItem Content="Mouse 5" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Key" />
                                    <ctrl:KeyPickerBox Grid.Column="1"
                                        IsEnabled="{Binding controlledMulticlickClickUseMouseButton, Converter={StaticResource InverseBool}}"
                                        KeyCode="{Binding controlledMulticlickClickKeyCode, Mode=TwoWay}" />
                                </Grid>
                                <CheckBox Margin="0,3" Content="Trigger on release" IsChecked="{Binding controlledMulticlickClickTriggerOnRelease, Mode=TwoWay}" />
                                <CheckBox Margin="0,3" Content="Separate left / right clicks" IsChecked="{Binding controlledMulticlickClickSeparateLR, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Auto-Find ──────────────────────────────────────────────── -->
                    <StackPanel x:Name="pageAutoFind" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Game executables" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowLabel}" Margin="0,0,0,6"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Semicolon-separated list of game .exe names to auto-find and pair." />
                                <TextBox Text="{Binding autoFindExecutables, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Hotkey" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Auto-find key" />
                                    <ctrl:KeyPickerBox Grid.Column="1" KeyCode="{Binding autoFindWindowsKeyCode, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel x:Name="autoFindModifiersPanel" Margin="0,3" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource RowLabel}" Margin="0,0,12,0" Text="Modifiers:" />
                                    <CheckBox Margin="0,0,12,0" Content="Alt" IsChecked="{Binding Alt, Mode=TwoWay}" />
                                    <CheckBox Margin="0,0,12,0" Content="Ctrl" IsChecked="{Binding Control, Mode=TwoWay}" />
                                    <CheckBox Content="Shift" IsChecked="{Binding Shift, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Layout Presets ─────────────────────────────────────────── -->
                    <StackPanel x:Name="pageLayoutPresets" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Layout presets" />
                        <TextBlock
                            Margin="2,0,0,8"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="Each preset's hotkey arranges the controller windows across your monitors." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox
                                x:Name="layoutPresetsList"
                                Grid.Column="0"
                                Height="180"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Presets}"
                                SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <ui:Button MinWidth="80" Content="Add" Click="LpAdd_Click" />
                                <ui:Button MinWidth="80" Margin="0,6,0,0" Content="Edit" Click="LpEdit_Click" />
                                <ui:Button MinWidth="80" Margin="0,6,0,0" Content="Delete" Click="LpDelete_Click" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <CheckBox Content="Lefts first (controller order when applying a preset)"
                                    IsChecked="{Binding layoutPriorityLeftsFirst, Source={x:Static props:Settings.Default}, Mode=TwoWay}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="Lefts first: G1P1L, G1P2L, G1P1R, G1P2R…   Pairs first: G1P1L, G1P1R, G1P2L, G1P2R…" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Colors ─────────────────────────────────────────────────── -->
                    <StackPanel x:Name="pageColors" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Border colours" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Multi-Mode left toon" />
                                    <ctrl:ColorSwatch Grid.Column="1" ColorArgb="{Binding multiModeLeftBorderColor, Mode=TwoWay}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Multi-Mode right toon" />
                                    <ctrl:ColorSwatch Grid.Column="1" ColorArgb="{Binding multiModeRightBorderColor, Mode=TwoWay}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Mirror Mode" />
                                    <ctrl:ColorSwatch Grid.Column="1" ColorArgb="{Binding mirrorModeBorderColor, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Focused mode" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Focused window" />
                                    <ctrl:ColorSwatch Grid.Column="1" ColorArgb="{Binding focusedModeFocusedColor, Mode=TwoWay}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Unfocused window" />
                                    <ctrl:ColorSwatch Grid.Column="1" ColorArgb="{Binding focusedModeUnfocusedColor, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Switching mode" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Switching (base)" />
                                    <ctrl:ColorSwatch Grid.Column="1" ColorArgb="{Binding switchingModeColor, Mode=TwoWay}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Selected window" />
                                    <ctrl:ColorSwatch Grid.Column="1" ColorArgb="{Binding switchingSelectedColor, Mode=TwoWay}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Switched window" />
                                    <ctrl:ColorSwatch Grid.Column="1" ColorArgb="{Binding switchingSwitchedColor, Mode=TwoWay}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Marked for removal" />
                                    <ctrl:ColorSwatch Grid.Column="1" ColorArgb="{Binding switchingRemovedColor, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Custom Modes ───────────────────────────────────────────── -->
                    <StackPanel x:Name="pageCustomModes" Visibility="Collapsed">
                        <TextBlock
                            Margin="2,8,0,8"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="Targets are 1-based (same order as instant multi-click). A binding sends a role from your Multi-Mode Keys (or Zero Power Throw), a raw key, or an instant click to one toon, all toons, or a listed set. First matching binding wins." />
                        <CheckBox
                            Margin="2,0,0,8"
                            Content="Allow custom modes in the mode-key cycle"
                            IsChecked="{Binding customModeCycleWithModeHotkey, Source={x:Static props:Settings.Default}, Mode=TwoWay}" />

                        <!-- Modes master + detail -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <ListBox
                                    x:Name="cmModesList"
                                    Height="150"
                                    ItemsSource="{Binding Modes}"
                                    SelectedItem="{Binding SelectedMode, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                    <ui:Button Content="Add mode" Click="CmAddMode_Click" />
                                    <ui:Button Margin="6,0,0,0" Content="Remove" Click="CmRemoveMode_Click" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource Card}" DataContext="{Binding SelectedMode}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Margin="0,0,0,2" Text="Mode name" />
                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Grid Margin="0,8,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Activation hotkey (optional)" />
                                        <ctrl:KeyPickerBox Grid.Column="1" KeyCode="{Binding ActivationKeyCode, Mode=TwoWay}" />
                                    </Grid>
                                    <StackPanel Margin="0,3" Orientation="Horizontal">
                                        <CheckBox Margin="0,0,12,0" Content="Alt" IsChecked="{Binding ActAlt, Mode=TwoWay}" />
                                        <CheckBox Margin="0,0,12,0" Content="Ctrl" IsChecked="{Binding ActCtrl, Mode=TwoWay}" />
                                        <CheckBox Margin="0,0,12,0" Content="Shift" IsChecked="{Binding ActShift, Mode=TwoWay}" />
                                        <CheckBox Content="Global hotkey" IsChecked="{Binding ActGlobal, Mode=TwoWay}" />
                                    </StackPanel>
                                    <CheckBox Margin="0,3" Content="Include this mode in the mode-key cycle" IsChecked="{Binding IncludeInCycle, Mode=TwoWay}" />

                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource RowLabel}" Margin="0,0,8,0" Text="Left border" />
                                        <ctrl:ColorSwatch Width="70" ColorArgb="{Binding LeftColorArgb, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource RowLabel}" Margin="16,0,8,0" Text="Right border" />
                                        <ctrl:ColorSwatch Width="70" ColorArgb="{Binding RightColorArgb, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Bindings -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Bindings" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox
                                x:Name="cmBindingsList"
                                Grid.Column="0"
                                Height="120"
                                ItemsSource="{Binding SelectedMode.Bindings}"
                                SelectedItem="{Binding SelectedBinding, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Summary}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <ui:Button Content="Add binding" Click="CmAddBinding_Click" />
                                <ui:Button Margin="0,6,0,0" Content="Remove" Click="CmRemoveBinding_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- Selected binding detail -->
                        <Border Style="{StaticResource Card}" Margin="0,6,0,0" DataContext="{Binding SelectedBinding}">
                            <StackPanel>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" MinWidth="70" Text="Input key" />
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Left" Margin="12,0,0,0" Orientation="Horizontal">
                                        <ctrl:KeyPickerBox VerticalAlignment="Center" KeyCode="{Binding InputKeyCode, Mode=TwoWay}" />
                                        <CheckBox Margin="12,0,0,0" VerticalAlignment="Center" Content="Alt" IsChecked="{Binding RequireAlt, Mode=TwoWay}" />
                                        <CheckBox Margin="8,0,0,0" VerticalAlignment="Center" Content="Ctrl" IsChecked="{Binding RequireControl, Mode=TwoWay}" />
                                        <CheckBox Margin="8,0,0,0" VerticalAlignment="Center" Content="Shift" IsChecked="{Binding RequireShift, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Action" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Right" MinWidth="220" SelectedIndex="{Binding ActionIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Send role (from key bindings)" />
                                        <ComboBoxItem Content="Send raw key" />
                                        <ComboBoxItem Content="Instant click" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,3" Visibility="{Binding IsSendRole, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Role" />
                                    <ComboBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        MinWidth="200"
                                        ItemsSource="{Binding DataContext.RoleTitles, ElementName=pageCustomModes}"
                                        SelectedItem="{Binding RoleTitle, Mode=TwoWay}" />
                                </Grid>
                                <Grid Margin="0,3" Visibility="{Binding IsSendRawKey, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Raw key" />
                                    <ctrl:KeyPickerBox Grid.Column="1" HorizontalAlignment="Right" KeyCode="{Binding RawKeyCode, Mode=TwoWay}" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Target(s)" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Right" MinWidth="220" SelectedIndex="{Binding TargetKindIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="One toon (# below)" />
                                        <ComboBoxItem Content="All toons" />
                                        <ComboBoxItem Content="Listed (comma-separated #s)" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,3" Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Toon #" />
                                    <TextBox Grid.Column="1" HorizontalAlignment="Right" Width="60" Text="{Binding TargetIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,3" Visibility="{Binding IsListed, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Indices" />
                                    <TextBox Grid.Column="1" Margin="12,0,0,0" Text="{Binding ListedIndicesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <CheckBox Margin="0,3" Content="Consume the input key (don't pass it through)" IsChecked="{Binding ConsumeInput, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border
            Grid.Row="2"
            Padding="16,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    MinWidth="90"
                    Appearance="Primary"
                    Content="OK"
                    Click="OkButton_Click" />
                <ui:Button
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Content="Cancel"
                    Click="CancelButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
