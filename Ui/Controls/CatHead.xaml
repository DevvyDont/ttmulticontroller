<UserControl
    x:Class="TTMulti.Ui.Controls.CatHead"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TTMulti.Ui.Controls">
    <UserControl.Resources>
        <!-- Cute cat-head silhouette traced from the reference art (example 1). 64 wide × ~52 tall. -->
        <StreamGeometry x:Key="CatHead">M59.2,0.2 C57.1,0.5 54.2,1.4 51.4,2.8 C48.9,4.0 47.3,5.1 45.1,7.0 C44.9,7.2 44.7,7.1 43.9,6.8 C39.7,5.2 36.1,4.5 31.2,4.7 C26.5,4.7 23.4,5.4 18.9,7.3 C18.5,7.5 18.4,7.5 17.7,6.9 C14.2,3.9 7.2,1.0 3.5,1.0 C1.9,1.0 0.7,1.7 0.4,2.8 C0.1,3.6 0.0,7.1 0.2,9.0 C0.6,12.7 1.7,18.4 2.4,20.3 C2.8,21.6 3.6,22.9 4.0,23.3 L4.3,23.6 L4.1,24.8 C3.9,25.6 3.8,26.8 3.7,28.4 C3.7,30.3 3.7,31.0 4.0,32.3 C5.0,38.1 8.4,42.9 14.1,46.2 C24.0,52.1 39.7,52.2 49.8,46.4 C51.8,45.2 53.1,44.2 54.7,42.6 C57.7,39.7 59.4,36.4 60.1,32.4 C60.5,30.2 60.4,26.6 59.9,24.4 L59.6,23.0 L60.0,22.5 C61.2,21.1 61.9,19.3 62.6,16.1 C63.5,11.6 64.0,7.9 64.0,5.1 C64.0,2.2 63.6,1.0 62.5,0.5 C61.8,0.1 60.5,0.0 59.2,0.2 Z</StreamGeometry>

        <!-- Face colour auto-picks black/white for contrast against this cat's fill colour. -->
        <local:LuminanceContrastConverter x:Key="FaceContrast" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Canvas Width="64" Height="52">
        <!-- Head -->
        <Path Data="{StaticResource CatHead}"
              Fill="{Binding Fill, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
              Stroke="{Binding RimBrush, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
              StrokeThickness="2.5" />

        <!-- Face (eyes / nose / whiskers). Hidden at small icon sizes where the fine detail just turns to mud;
             the plain coloured silhouette reads far better there. -->
        <Canvas Visibility="{Binding ShowFace, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
            <!-- Eyes (positions from the reference) -->
            <Ellipse Canvas.Left="20.3" Canvas.Top="24.1" Width="4.0" Height="5.7"
                     Fill="{Binding Fill, Converter={StaticResource FaceContrast}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
            <Ellipse Canvas.Left="39.7" Canvas.Top="24.1" Width="4.0" Height="5.7"
                     Fill="{Binding Fill, Converter={StaticResource FaceContrast}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

            <!-- Nose -->
            <Path Fill="{Binding Fill, Converter={StaticResource FaceContrast}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                  Data="M29.3,32 L34.7,32 C34,35.6 30,35.6 29.3,32 Z" />

            <!-- Whiskers: three per side, curved and fanned like the reference — the top nearly flat, the
                 middle and lower drooping progressively more. -->
            <Path Stroke="{Binding Fill, Converter={StaticResource FaceContrast}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                  StrokeThickness="0.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M25.4,33.9 Q18.5,33 11.9,35.1 M25.7,35.3 Q17.5,37 11.4,41.4 M25.9,37.2 Q20.5,39 16.9,43.2
                        M38.6,33.9 Q45.5,33 52.1,35.1 M38.3,35.3 Q46.5,37 52.6,41.4 M38.1,37.2 Q43.5,39 47.1,43.2" />
        </Canvas>
    </Canvas>
</UserControl>
