<UserControl
    x:Class="TTMulti.Ui.Controls.AppLogo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The logo is the new yin-yang cats (Resources/icon-new.png), duotone-recoloured at runtime: the black
         cat takes the Mirror-mode colour and the white cat the Multi-mode colour. See AppLogo.xaml.cs and
         LogoImages for the recolour. -->
    <Image x:Name="Img" Stretch="Uniform" SnapsToDevicePixels="True" />
</UserControl>
